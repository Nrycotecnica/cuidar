# Copie para deploy/homolog.env e deploy/producao.env (valores DIFERENTES em cada um).
# Nunca versione estes arquivos (estão no .gitignore).
POSTGRES_DB=ventilacao
POSTGRES_USER=ventilacao
POSTGRES_PASSWORD=troque-por-senha-forte
PGUSER=ventilacao
PGPASSWORD=troque-por-senha-forte
PGDATABASE=ventilacao
# Em producao.env troque db-homolog por db-producao
DATABASE_URL=postgresql+psycopg://ventilacao:troque-por-senha-forte@db-homolog:5432/ventilacao
# Gere com: openssl rand -hex 32
SECRET_KEY=troque
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-por-senha-forte
ADMIN_NOME=Administrador
# Homologação: true (carrega dados demonstrativos). Produção: false
SEED_DEMO=true
# Opcional: habilita o assistente com IA (Claude)
ANTHROPIC_API_KEY=
# Opcional: conversão de DWG (caminho do ODA File Converter dentro do contêiner)
ODA_CONVERTER_PATH=
